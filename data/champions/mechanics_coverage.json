  "policy_approximations": [
    {
      "id": "myopic_prior_in_exact_ranking",
      "where": "vgc.rl.exact_search.search_joint_orders_exact, search_myopic_weight",
      "what": "The final rank blends the exact branch outcome with vgc.evaluator's one-turn heuristic score, which still uses vgc.damage's expected-value shortcuts for accuracy, critical hits, and secondary effects.",
      "why_not_a_mechanics_gap": "It never decides what happens in a predicted turn; Showdown does. It only expresses a strategic preference over turns Showdown already resolved. Zeroing it would change frozen, gate-tuned heuristic weights and needs a same-session A/B, not a mechanics review."
    },
    {
      "id": "candidate_shortlisting",
      "where": "vgc.search._select_search_candidates, search_our_candidates",
      "what": "Only the top candidates are simulated exactly; the tail is ranked below them by heuristic score alone.",
      "why_not_a_mechanics_gap": "A compute budget, not a rule approximation. Every candidate that is searched is searched exactly."
    },
    {
      "id": "exact_branch_position_value",
      "where": "vgc.rl.exact_search._position_value",
      "what": "Scoring a resulting Showdown position uses hand-chosen weights for HP, status, boosts, and active effects.",
      "why_not_a_mechanics_gap": "Showdown decides which position is reached; this only says how much that position is liked. It is the value function, and improving it is RL work."
    },
    {
      "id": "opponent_response_model",
      "where": "vgc.rl.exact_search, search_opp_candidates and the softmax weights",
      "what": "The opponent's likely replies come from the heuristic evaluator.",
      "why_not_a_mechanics_gap": "Predicting an opponent's choice is opponent modelling, not a game rule. Each modelled reply is still executed exactly."
    }
  ],
  "information_uncertainty": [
    {
      "id": "hidden_opponent_team_sheet",
      "handling": "The deployed policy rejects Open Team Sheets. Opponent moves, item, ability, nature, Stat Points, and selected four remain unknown until ordinary public battle events reveal them; set and usage priors provide weighted hypotheses rather than private truth."
    },
    {
      "id": "hidden_opponent_spread_and_nature",
      "handling": "Estimated from usage priors when rebuilding a live mirror. vgc.sets.opponent_spread_hypotheses exposes the full weighted distribution and PolicyConfig.exact_search_spread_hypotheses builds one Showdown root per belief; it ships at 1 (the most popular spread, treated as a point estimate) because raising it changes gate-tuned behaviour and needs a same-session A/B."
    },
    {
      "id": "hidden_sleep_and_confusion_timers",
      "handling": "Enumerated as weighted legal branches by vgc.rl.hidden_state and averaged by vgc.rl.exact_search.combine_belief_rankings, rather than assumed."
    },
    {
      "id": "opponent_unrevealed_bring_and_bench",
      "handling": "Ordered by revealed-first hypothesis when building the live mirror."
    }
  ]
}
