+    /// Fog-safe `rich` observation (`float32` array of length `1028`) directly from the
+    /// battle's internal state (used on `patch_public` search leaves whose log starts fresh).
+    #[pyo3(signature = (side, foe_known_items=None, foe_known_abilities=None, foe_known_moves=None))]
+    fn encode_state_rich<'py>(
+        &self,
+        py: Python<'py>,
+        side: &Bound<'py, PyAny>,
+        foe_known_items: Option<Vec<Option<String>>>,
+        foe_known_abilities: Option<Vec<Option<String>>>,
