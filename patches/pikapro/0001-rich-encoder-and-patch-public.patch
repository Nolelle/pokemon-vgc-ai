+//! The `rich` observation: structured token-ready features for transformer policies.
+//!
+//! Layout (`SIZE = 1028` floats per player):
+//! - `12` Pokémon rows (`6` own, `6` foe) × `80` floats (`0..960`):
+//!   - `0..8`: categorical IDs as exact integer floats (`species`, `item`, `ability`,
+//!     `active_slot`, `move0..3`), `0` for unknown/absent.
+//!   - `8..16`: `present`, `is_own`, `is_active`, `is_fainted`, `is_revealed`,
+//!     `is_mega`, `is_brought`, `hp_frac`.
+//!   - `16..23`: status one-hot (`brn`, `frz`, `par`, `psn`, `tox`, `slp`),
+//!     `status_turns / 6`.
+//!   - `23..30`: stat boosts (`atk..eva / 6`).
+//!   - `30..48`: current types one-hot (`18`).
+//!   - `48..54`: exact stats `[hp, atk, def, spa, spd, spe] / 255` (own only).
+//!   - `54..60`: base stats `[hp, atk, def, spa, spd, spe] / 255`.
+//!   - `60..66`: `protect_chain / 4`, `first_turn`, `turns_active / 10`,
+//!     `can_mega`, `trapped`, `moved_this_turn`.
+//!   - `66..74`: `move0..3_pp_frac`, `move0..3_disabled`.
+//!   - `74..80`: volatile flags (`must_recharge`, `charging`, `taunt`, `encore`,
+//!     `confusion`, `substitute`).
+//! - `2` Side blocks (own `960..980`, foe `980..1000`) × `20` floats.
+//! - `1` Field block (`1000..1028`) × `28` floats.
+
+use pikapro::state::{SideCondition, Status, Terrain, Volatiles, Weather};
+use pikapro::{Battle, MAX_ACTIVE, MAX_MOVES, Request, SideId};
+use pikapro_data::{AbilityId, ItemId, MoveId, Stat, Type};
+use pikapro_view::{AbilityState, ItemState, OwnRequest, PlayerView, PublicVolatiles as PV};
+
+use super::ctx::{MonRef, ROWS, ViewCtx};
+use super::{Encoder, flag, one_hot};
+use crate::tables::Tables;
+
+const TYPES: usize = Type::COUNT; // 18
+/// Values per Pokémon row (`8` IDs + `80` continuous/flag floats).
+pub const RICH_MON_WIDTH: usize = 88;
+/// Values per side block.
+pub const RICH_SIDE_WIDTH: usize = 20;
+/// Values in the global field block.
+pub const RICH_FIELD_WIDTH: usize = 28;
+
+const WEATHER_LEN: usize = 7;
+const TERRAIN_LEN: usize = 4;
+
+const fn weather_index(w: Weather) -> usize {
+    match w {
+        Weather::Sun => 0,
+        Weather::Rain => 1,
+        Weather::Sand => 2,
+        Weather::Snow => 3,
+        Weather::HarshSun => 4,
+        Weather::HeavyRain => 5,
+        Weather::StrongWinds => 6,
+    }
+}
+
+const fn terrain_index(t: Terrain) -> usize {
+    match t {
+        Terrain::Electric => 0,
+        Terrain::Grassy => 1,
+        Terrain::Misty => 2,
+        Terrain::Psychic => 3,
+    }
+}
+
+/// The `rich` observation encoder for transformer policies.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Rich;
+
+impl Rich {
+    /// Total `f32` values written per player (`12 * 80 + 2 * 20 + 28 = 1028`).
+    pub const SIZE: usize = 2 * ROWS * RICH_MON_WIDTH + 2 * RICH_SIDE_WIDTH + RICH_FIELD_WIDTH;
+
+    /// Column names, in order.
+    pub fn columns() -> Vec<String> {
+        let mut names = Vec::with_capacity(Self::SIZE);
+        let statuses = ["brn", "frz", "par", "psn", "tox", "slp"];
+        let boosts = ["atk", "def", "spa", "spd", "spe", "accuracy", "evasion"];
+        let stats = ["hp", "atk", "def", "spa", "spd", "spe"];
+        for who in ["own", "foe"] {
+            for row in 0..ROWS {
+                let p = format!("{who}{row}");
+                names.extend(
+                    ["species_id", "item_id", "ability_id", "active_slot", "move0_id", "move1_id", "move2_id", "move3_id"]
+                        .map(|n| format!("{p}.{n}")),
+                );
+                names.extend(
+                    ["present", "is_own", "is_active", "is_fainted", "is_revealed", "is_mega", "is_brought", "hp_frac"]
+                        .map(|n| format!("{p}.{n}")),
+                );
+                names.extend(statuses.map(|n| format!("{p}.status_{n}")));
+                names.push(format!("{p}.status_turns"));
+                names.extend(boosts.map(|n| format!("{p}.boost_{n}")));
+                names.extend((0..TYPES).map(|t| format!("{p}.type_{}", Type::ALL[t].name().to_ascii_lowercase())));
+                names.extend(stats.map(|n| format!("{p}.exact_{n}")));
+                names.extend(stats.map(|n| format!("{p}.base_{n}")));
+                names.extend(
+                    ["protect_chain", "first_turn", "turns_active", "can_mega", "trapped", "moved_this_turn"]
+                        .map(|n| format!("{p}.{n}")),
+                );
+                for k in 0..MAX_MOVES {
+                    names.push(format!("{p}.move{k}_pp"));
+                }
+                for k in 0..MAX_MOVES {
+                    names.push(format!("{p}.move{k}_disabled"));
+                }
+                names.extend(
+                    [
+                        "vol_recharge",
+                        "vol_charging",
+                        "vol_taunt",
+                        "vol_encore",
+                        "vol_confusion",
+                        "vol_substitute",
+                        "perish_turns",
+                        "vol_yawn",
+                        "vol_leech_seed",
+                        "vol_salt_cure",
+                        "vol_disable",
+                        "vol_heal_block",
+                        "vol_throat_chop",
+                        "vol_locked_or_dot",
+                    ]
+                    .map(|n| format!("{p}.{n}")),
+                );
+            }
+        }
+        for who in ["own_side", "foe_side"] {
+            names.extend(
+                [
+                    "team_size",
+                    "fainted",
+                    "mega_used",
+                    "tailwind",
+                    "tailwind_turns",
+                    "reflect",
+                    "reflect_turns",
+                    "light_screen",
+                    "light_screen_turns",
+                    "aurora_veil",
+                    "aurora_veil_turns",
+                    "safeguard",
+                    "mist",
+                    "wide_guard",
+                    "quick_guard",
+                    "stealth_rock",
+                    "spikes",
+                    "toxic_spikes",
+                    "sticky_web",
+                    "pledge",
+                ]
+                .map(|n| format!("{who}.{n}")),
+            );
+        }
+        names.extend(
+            ["sun", "rain", "sand", "snow", "harsh_sun", "heavy_rain", "strong_winds"]
+                .map(|n| format!("field.weather_{n}")),
+        );
+        names.push("field.weather_turns".into());
+        names.extend(["electric", "grassy", "misty", "psychic"].map(|n| format!("field.terrain_{n}")));
+        names.push("field.terrain_turns".into());
+        names.extend([
+            "field.trick_room".into(),
+            "field.trick_room_turns".into(),
+            "field.gravity".into(),
+            "field.gravity_turns".into(),
+            "field.magic_room".into(),
+            "field.wonder_room".into(),
+            "field.fairy_lock".into(),
+            "field.turn".into(),
+            "field.request_wait".into(),
+            "field.request_team_preview".into(),
+            "field.request_move".into(),
+            "field.request_force_switch".into(),
+            "field.force_switch_0".into(),
+            "field.force_switch_1".into(),
+            "field.active_count".into(),
+        ]);
+        debug_assert_eq!(names.len(), Self::SIZE);
+        names
+    }
+}
+
+fn encode_mon_view(m: &MonRef<'_>, tables: &Tables, o: &mut [f32]) {
+    if !m.present() {
+        return;
+    }
+    // 0..8: categorical IDs
+    let species = m.species();
+    o[0] = species.map_or(0.0, |id| (id.index() + 1) as f32);
+    o[1] = match m.item() {
+        ItemState::Known(id) => (id.index() + 1) as f32,
+        _ => 0.0,
+    };
+    o[2] = match m.ability() {
+        AbilityState::Known(id) => (id.index() + 1) as f32,
+        _ => 0.0,
+    };
+    o[3] = m.slot.map_or(0.0, |s| f32::from(s + 1));
+
+    // Moves: IDs in 4..8, PP in 66..70, disabled in 70..74.
+    m.each_move_pp(|i, mv| {
+        if i >= MAX_MOVES {
+            return;
+        }
+        if let Some(id) = mv.slot.id() {
+            o[4 + i] = (id.index() + 1) as f32;
+            o[66 + i] = mv.pp_frac(tables);
+            o[70 + i] = flag(mv.disabled);
+        }
+    });
+
+    // 8..16: core flags + HP
+    o[8] = 1.0;
+    o[9] = flag(m.own);
+    o[10] = flag(m.is_active());
+    o[11] = flag(m.is_fainted());
+    o[12] = flag(m.own || m.is_revealed());
+    o[13] = flag(m.is_mega());
+    o[14] = flag(m.brought || m.is_active() || m.is_fainted() || m.is_revealed());
+    o[15] = m.hp_frac();
+
+    // 16..23: status one-hot + status turns
+    let status = m.status() as usize;
+    if status > 0 {
+        one_hot(&mut o[16..22], status - 1);
+    }
+    o[22] = f32::from(m.status_turns().min(6)) / 6.0;
+
+    // 23..30: boosts (active only)
+    if m.is_active() {
+        for (k, b) in m.boosts().into_iter().enumerate() {
+            o[23 + k] = f32::from(b) / 6.0;
+        }
+    }
+
+    // 30..48: types one-hot
+    if let Some(t) = m.types(tables) {
+        let types = &mut o[30..48];
+        one_hot(types, t.set.primary as usize);
+        if let Some(s) = t.set.secondary {
+            one_hot(types, s as usize);
+        }
+        if let Some(a) = t.added {
+            one_hot(types, a as usize);
+        }
+    }
+
+    // 48..54: exact stats (own only)
+    if let Some(st) = m.exact_stats() {
+        for (k, v) in st.into_iter().enumerate() {
+            o[48 + k] = f32::from(v) / 255.0;
+        }
+    }
+
+    // 54..60: species base stats
+    if let Some(sp) = species {
+        let bs = tables.dex.species(sp).base_stats;
+        o[54] = f32::from(bs[Stat::Hp]) / 255.0;
+        o[55] = f32::from(bs[Stat::Atk]) / 255.0;
+        o[56] = f32::from(bs[Stat::Def]) / 255.0;
+        o[57] = f32::from(bs[Stat::SpA]) / 255.0;
+        o[58] = f32::from(bs[Stat::SpD]) / 255.0;
+        o[59] = f32::from(bs[Stat::Spe]) / 255.0;
+    }
+
+    // 60..66: tactical counters
+    if let Some(act) = m.active {
+        o[60] = f32::from(act.counters.protect_chain.min(4)) / 4.0;
+        o[61] = flag(m.is_active() && act.turns_active <= 1 && !act.moved_this_turn);
+        o[62] = f32::from(act.turns_active.min(10)) / 10.0;
+        let v = act.volatiles;
+        o[64] = flag(
+            m.request.is_some_and(|r| r.trapped)
+                || v.has(PV::TRAPPED | PV::PARTIALLY_TRAPPED),
+        );
+        o[65] = flag(act.moved_this_turn);
+        // 74..80: key public volatiles
+        o[74] = flag(v.has(PV::MUST_RECHARGE));
+        o[75] = flag(v.has(PV::CHARGING));
+        o[76] = flag(v.has(PV::TAUNT));
+        o[77] = flag(v.has(PV::ENCORE));
+        o[78] = flag(v.has(PV::CONFUSION));
+        o[79] = flag(v.has(PV::SUBSTITUTE));
+        // 80..88: extended VGC counters & residual/control volatiles
+        o[80] = if v.has(PV::PERISH_SONG) {
+            f32::from(act.counters.perish.min(3)) / 3.0
+        } else {
+            0.0
+        };
+        o[81] = flag(v.has(PV::YAWN));
+        o[82] = flag(v.has(PV::LEECH_SEED));
+        o[83] = flag(v.has(PV::SALT_CURE));
+        o[84] = flag(v.has(PV::DISABLE));
+        o[85] = flag(v.has(PV::HEAL_BLOCK));
+        o[86] = flag(v.has(PV::THROAT_CHOP));
+        o[87] = flag(v.has(PV::LOCKED_MOVE | PV::PARTIALLY_TRAPPED | PV::CURSE | PV::SYRUP_BOMB));
+    }
+    o[63] = flag(m.request.is_some_and(|r| r.can_mega_evo));
+}
+
+fn extended_turns_frac(elapsed: u8) -> f32 {
+    // Base duration is 5 turns; if a screen, weather, or terrain is still active at
+    // elapsed >= 5, an 8-turn extender item (Light Clay / Weather Rock / Terrain Extender)
+    // is publicly proven, so report the remaining turns out of 8 rather than 0.0.
+    let rem = if elapsed < 5 {
+        5 - elapsed
+    } else {
+        8u8.saturating_sub(elapsed)
+    };
+    f32::from(rem.min(5)) / 5.0
+}
+
+fn encode_side_view(ctx: &ViewCtx<'_>, side: usize, o: &mut [f32]) {
+    let s = ctx.sides[side];
+    let size = s.team_size.min(ROWS as u8);
+    o[0] = f32::from(size) / 6.0;
+    o[1] = if size > 0 { f32::from(s.fainted.min(size)) / f32::from(size) } else { 0.0 };
+    o[2] = flag(s.mega_used || s.tera_used);
+
+    let tw = s.condition(SideCondition::Tailwind);
+    o[3] = flag(tw.layers > 0);
+    o[4] = if tw.layers > 0 { f32::from(4u8.saturating_sub(tw.turns)) / 4.0 } else { 0.0 };
+
+    let rf = s.condition(SideCondition::Reflect);
+    o[5] = flag(rf.layers > 0);
+    o[6] = if rf.layers > 0 { extended_turns_frac(rf.turns) } else { 0.0 };
+
+    let ls = s.condition(SideCondition::LightScreen);
+    o[7] = flag(ls.layers > 0);
+    o[8] = if ls.layers > 0 { extended_turns_frac(ls.turns) } else { 0.0 };
+
+    let av = s.condition(SideCondition::AuroraVeil);
+    o[9] = flag(av.layers > 0);
+    o[10] = if av.layers > 0 { extended_turns_frac(av.turns) } else { 0.0 };
+
+    o[11] = flag(s.condition(SideCondition::Safeguard).layers > 0);
+    o[12] = flag(s.condition(SideCondition::Mist).layers > 0);
+    o[13] = flag(s.condition(SideCondition::WideGuard).layers > 0);
+    o[14] = flag(s.condition(SideCondition::QuickGuard).layers > 0);
+    o[15] = flag(s.condition(SideCondition::StealthRock).layers > 0);
+    o[16] = f32::from(s.condition(SideCondition::Spikes).layers.min(3)) / 3.0;
+    o[17] = f32::from(s.condition(SideCondition::ToxicSpikes).layers.min(2)) / 2.0;
+    o[18] = flag(s.condition(SideCondition::StickyWeb).layers > 0);
+    o[19] = flag(
+        s.condition(SideCondition::FirePledge).layers > 0
+            || s.condition(SideCondition::GrassPledge).layers > 0
+            || s.condition(SideCondition::WaterPledge).layers > 0,
+    );
+}
+
+fn encode_field_view(ctx: &ViewCtx<'_>, o: &mut [f32]) {
+    let f = ctx.view.field();
+    if let Some(w) = f.weather {
+        one_hot(&mut o[0..WEATHER_LEN], weather_index(w));
+        o[7] = extended_turns_frac(f.weather_turns);
+    }
+    if let Some(t) = f.terrain {
+        one_hot(&mut o[8..8 + TERRAIN_LEN], terrain_index(t));
+        o[12] = extended_turns_frac(f.terrain_turns);
+    }
+    if let Some(tr) = f.trick_room {
+        o[13] = 1.0;
+        o[14] = f32::from(5u8.saturating_sub(tr.min(5))) / 5.0;
+    }
+    if let Some(g) = f.gravity {
+        o[15] = 1.0;
+        o[16] = f32::from(5u8.saturating_sub(g.min(5))) / 5.0;
+    }
+    o[17] = flag(f.magic_room.is_some());
+    o[18] = flag(f.wonder_room.is_some());
+    o[19] = flag(f.fairy_lock);
+    o[20] = f32::from(ctx.view.turn().min(100)) / 100.0;
+    let (req_idx, fs0, fs1) = match ctx.view.own.request {
+        OwnRequest::Wait => (0, false, false),
+        OwnRequest::TeamPreview { .. } => (1, false, false),
+        OwnRequest::Move => (2, false, false),
+        OwnRequest::ForceSwitch { slots } => (3, slots.first().copied().unwrap_or(false), slots.get(1).copied().unwrap_or(false)),
+    };
+    one_hot(&mut o[21..25], req_idx);
+    o[25] = flag(fs0);
+    o[26] = flag(fs1);
+    let active_count = ctx.slot_rows[0].iter().filter(|s| s.is_some()).count();
+    o[27] = active_count as f32 / 2.0;
+}
+
+impl Encoder for Rich {
+    fn size(&self) -> usize {
+        Self::SIZE
+    }
+
+    fn encode(&self, view: &PlayerView<'_>, tables: &Tables, out: &mut [f32]) {
+        out.fill(0.0);
+        let ctx = ViewCtx::new(view, tables);
+        for (side, rows) in ctx.mons.iter().enumerate() {
+            for (row, m) in rows.iter().enumerate() {
+                let start = (side * ROWS + row) * RICH_MON_WIDTH;
+                encode_mon_view(m, tables, &mut out[start..start + RICH_MON_WIDTH]);
+            }
+        }
+        let side_base = 2 * ROWS * RICH_MON_WIDTH;
+        encode_side_view(&ctx, 0, &mut out[side_base..side_base + RICH_SIDE_WIDTH]);
+        encode_side_view(&ctx, 1, &mut out[side_base + RICH_SIDE_WIDTH..side_base + 2 * RICH_SIDE_WIDTH]);
+        let field_base = side_base + 2 * RICH_SIDE_WIDTH;
+        encode_field_view(&ctx, &mut out[field_base..field_base + RICH_FIELD_WIDTH]);
+    }
+}
+
+/// Fog-safe rich encoding directly from a [`Battle`] (used for patched search leaves
+/// whose event log does not contain earlier turns).
+///
+/// For `me`, full private team knowledge is encoded. For `me.foe()`, hidden items,
+/// abilities and unrevealed moves are masked to `0` unless explicitly marked in
+/// `foe_revealed_*` (or active/used during the simulated branch).
+pub fn encode_battle_state_rich(
+    battle: &Battle,
+    me: SideId,
+    tables: &Tables,
+    own_team: Option<&pikapro_view::OwnTeam>,
+    foe_team: Option<&pikapro_view::OwnTeam>,
+    foe_known_items: &[Option<ItemId>],
+    foe_known_abilities: &[Option<AbilityId>],
+    foe_known_moves: &[Vec<MoveId>],
+    out: &mut [f32],
+) {
+    out.fill(0.0);
+    let state = battle.state();
+    let dex = tables.dex;
+    let sides = [me, me.foe()];
+    let mut own_written = [false; ROWS];
+    let mut foe_written = [false; ROWS];
+    for (ego, side_id) in sides.into_iter().enumerate() {
+        let side = state.side(side_id);
+        let is_own = ego == 0;
+        for (idx, mon) in side.team.iter().enumerate().take(ROWS) {
+            let row = (mon.id as usize).min(ROWS - 1);
+            if is_own {
+                own_written[row] = true;
+            } else {
+                foe_written[row] = true;
+            }
+            let o = &mut out[(ego * ROWS + row) * RICH_MON_WIDTH..][..RICH_MON_WIDTH];
+            let active_slot = (0..MAX_ACTIVE).find(|&s| side.active[s] == Some(idx as u8));
+            let is_active = active_slot.is_some();
+            let is_fainted = mon.is_fainted();
+            let is_revealed = is_own || is_active || is_fainted || mon.hp < mon.stats[Stat::Hp];
+
+            // 0..8: IDs
+            o[0] = (mon.species.index() + 1) as f32;
+            if is_own {
+                o[1] = mon.item.map_or(0.0, |id| (id.index() + 1) as f32);
+                o[2] = (mon.ability.index() + 1) as f32;
+            } else {
+                let item = foe_known_items.get(row).copied().flatten();
+                let ab = foe_known_abilities.get(row).copied().flatten();
+                o[1] = item.map_or(0.0, |id| (id.index() + 1) as f32);
+                o[2] = ab.map_or(0.0, |id| (id.index() + 1) as f32);
+            }
+            o[3] = active_slot.map_or(0.0, |s| (s + 1) as f32);
+
+            if is_own {
+                for (k, mv) in mon.moves.iter().enumerate().take(MAX_MOVES) {
+                    o[4 + k] = (mv.id.index() + 1) as f32;
+                    o[66 + k] = if mv.max_pp > 0 { f32::from(mv.pp) / f32::from(mv.max_pp) } else { 0.0 };
+                    o[70 + k] = flag(mv.disabled || (mon.effect_disabled & (1 << k)) != 0);
+                }
+            } else {
+                let known = foe_known_moves.get(row);
+                let mut written = 0usize;
+                for mv in mon.moves.iter().take(MAX_MOVES) {
+                    let was_used = mv.pp < mv.max_pp;
+                    let is_known = was_used || known.is_some_and(|list| list.contains(&mv.id));
+                    if is_known && written < MAX_MOVES {
+                        o[4 + written] = (mv.id.index() + 1) as f32;
+                        o[66 + written] = if mv.max_pp > 0 { f32::from(mv.pp) / f32::from(mv.max_pp) } else { 0.0 };
+                        o[70 + written] = flag(mv.disabled);
+                        written += 1;
+                    }
+                }
+            }
+
+            // 8..16: core flags + HP
+            o[8] = 1.0;
+            o[9] = flag(is_own);
+            o[10] = flag(is_active);
+            o[11] = flag(is_fainted);
+            o[12] = flag(is_revealed);
+            o[13] = flag(dex.species(mon.species).name.contains("-Mega"));
+            o[14] = flag(is_own || is_revealed);
+            o[15] = if mon.stats[Stat::Hp] > 0 {
+                f32::from(mon.hp) / f32::from(mon.stats[Stat::Hp])
+            } else {
+                0.0
+            };
+
+            // 16..23: status
+            let (st_idx, st_turns) = match mon.status {
+                Status::None => (0usize, 0u8),
+                Status::Burn => (1, 0),
+                Status::Freeze { turns } => (2, turns),
+                Status::Paralysis => (3, 0),
+                Status::Poison => (4, 0),
+                Status::Toxic { counter } => (5, counter),
+                Status::Sleep { turns } => (6, turns),
+            };
+            if st_idx > 0 {
+                one_hot(&mut o[16..22], st_idx - 1);
+            }
+            o[22] = f32::from(st_turns.min(6)) / 6.0;
+
+            // 23..30: boosts
+            if is_active {
+                let b = mon.boosts;
+                for (k, val) in [b.atk, b.def, b.spa, b.spd, b.spe, b.accuracy, b.evasion].into_iter().enumerate() {
+                    o[23 + k] = f32::from(val) / 6.0;
+                }
+            }
+
+            // 30..48: types
+            let types = &mut o[30..48];
+            one_hot(types, mon.types.primary as usize);
+            if let Some(s) = mon.types.secondary {
+                one_hot(types, s as usize);
+            }
+            if let Some(a) = mon.volatile_counters.added_type {
+                one_hot(types, a as usize);
+            }
+
+            // 48..54: exact stats (own only)
+            if is_own {
+                o[48] = f32::from(mon.stats[Stat::Hp]) / 255.0;
+                o[49] = f32::from(mon.stats[Stat::Atk]) / 255.0;
+                o[50] = f32::from(mon.stats[Stat::Def]) / 255.0;
+                o[51] = f32::from(mon.stats[Stat::SpA]) / 255.0;
+                o[52] = f32::from(mon.stats[Stat::SpD]) / 255.0;
+                o[53] = f32::from(mon.stats[Stat::Spe]) / 255.0;
+            }
+
+            // 54..60: base stats
+            let bs = dex.species(mon.species).base_stats;
+            o[54] = f32::from(bs[Stat::Hp]) / 255.0;
+            o[55] = f32::from(bs[Stat::Atk]) / 255.0;
+            o[56] = f32::from(bs[Stat::Def]) / 255.0;
+            o[57] = f32::from(bs[Stat::SpA]) / 255.0;
+            o[58] = f32::from(bs[Stat::SpD]) / 255.0;
+            o[59] = f32::from(bs[Stat::Spe]) / 255.0;
+
+            // 60..66: tactical counters
+            if is_active {
+                o[60] = f32::from(mon.protect_counter.min(4)) / 4.0;
+                o[61] = flag(mon.active_move_actions == 0 && mon.active_turns <= 1);
+                o[62] = f32::from((mon.active_turns.min(10)) as u8) / 10.0;
+                o[63] = flag(is_own && mon.can_mega_evo.is_some());
+                o[64] = flag(mon.trapped || mon.volatiles.has(Volatiles::TRAPPED | Volatiles::PARTIALLY_TRAPPED));
+                o[65] = flag(mon.active_move_actions > 0);
+                // 74..80: volatiles
+                o[74] = flag(mon.volatiles.has(Volatiles::MUST_RECHARGE));
+                o[75] = flag(mon.volatiles.has(Volatiles::CHARGING | Volatiles::TWO_TURN_MOVE));
+                o[76] = flag(mon.volatiles.has(Volatiles::TAUNT));
+                o[77] = flag(mon.volatiles.has(Volatiles::ENCORE));
+                o[78] = flag(mon.volatiles.has(Volatiles::CONFUSION));
+                o[79] = flag(mon.volatiles.has(Volatiles::SUBSTITUTE));
+                // 80..88: extended VGC counters & residual/control volatiles
+                o[80] = if mon.volatiles.has(Volatiles::PERISH_SONG) {
+                    f32::from(mon.volatile_counters.perish_song.min(3)) / 3.0
+                } else {
+                    0.0
+                };
+                o[81] = flag(mon.volatiles.has(Volatiles::YAWN));
+                o[82] = flag(mon.volatiles.has(Volatiles::LEECH_SEED));
+                o[83] = flag(mon.volatiles.has(Volatiles::SALT_CURE));
+                o[84] = flag(mon.volatiles.has(Volatiles::DISABLE));
+                o[85] = flag(mon.volatiles.has(Volatiles::HEAL_BLOCK));
+                o[86] = flag(mon.volatiles.has(Volatiles::THROAT_CHOP));
+                o[87] = flag(mon.volatiles.has(
+                    Volatiles::LOCKED_MOVE | Volatiles::PARTIALLY_TRAPPED | Volatiles::CURSE | Volatiles::SYRUP_BOMB,
+                ));
+            }
+        }
+    }
+
+    // Fill own Pokémon left out at team preview so row 0..5 matches PlayerView exactly.
+    if let Some(team) = own_team {
+        for (row, written) in own_written.iter().enumerate() {
+            if *written {
+                continue;
+            }
+            let Some(tm) = team.get(row as u8) else { continue };
+            if tm.level == 0 {
+                continue;
+            }
+            let o = &mut out[row * RICH_MON_WIDTH..][..RICH_MON_WIDTH];
+            o[0] = (tm.species.index() + 1) as f32;
+            o[1] = tm.item.map_or(0.0, |id| (id.index() + 1) as f32);
+            o[2] = (tm.ability.index() + 1) as f32;
+            for (k, &mv_id) in tm.moves.iter().enumerate().take(MAX_MOVES) {
+                o[4 + k] = (mv_id.index() + 1) as f32;
+                let max = u32::from(tables.move_facts(mv_id).max_pp);
+                o[66 + k] = if max > 0 { 1.0 } else { 0.0 };
+            }
+            o[8] = 1.0; // present
+            o[9] = 1.0; // is_own
+            o[12] = 1.0; // is_revealed (own)
+            o[15] = 1.0; // hp_frac
+            let sp_data = dex.species(tm.species);
+            one_hot(&mut o[30..48], sp_data.types.primary as usize);
+            if let Some(s) = sp_data.types.secondary {
+                one_hot(&mut o[30..48], s as usize);
+            }
+            for (k, v) in tm.stats.into_iter().enumerate() {
+                o[48 + k] = f32::from(v) / 255.0;
+            }
+            let bs = sp_data.base_stats;
+            o[54] = f32::from(bs[Stat::Hp]) / 255.0;
+            o[55] = f32::from(bs[Stat::Atk]) / 255.0;
+            o[56] = f32::from(bs[Stat::Def]) / 255.0;
+            o[57] = f32::from(bs[Stat::SpA]) / 255.0;
+            o[58] = f32::from(bs[Stat::SpD]) / 255.0;
+            o[59] = f32::from(bs[Stat::Spe]) / 255.0;
+        }
+    }
+
+    // Fill unbrought opponent preview Pokémon with strictly public preview info only
+    // (species, types, base stats — never hidden items, abilities, moves, or exact stats).
+    if let Some(team) = foe_team {
+        for (row, written) in foe_written.iter().enumerate() {
+            if *written {
+                continue;
+            }
+            let Some(tm) = team.get(row as u8) else { continue };
+            if tm.level == 0 {
+                continue;
+            }
+            let o = &mut out[(ROWS + row) * RICH_MON_WIDTH..][..RICH_MON_WIDTH];
+            o[0] = (tm.species.index() + 1) as f32;
+            o[8] = 1.0; // present
+            o[15] = 1.0; // public unrevealed hp_frac
+            let sp_data = dex.species(tm.species);
+            one_hot(&mut o[30..48], sp_data.types.primary as usize);
+            if let Some(s) = sp_data.types.secondary {
+                one_hot(&mut o[30..48], s as usize);
+            }
+            let bs = sp_data.base_stats;
+            o[54] = f32::from(bs[Stat::Hp]) / 255.0;
+            o[55] = f32::from(bs[Stat::Atk]) / 255.0;
+            o[56] = f32::from(bs[Stat::Def]) / 255.0;
+            o[57] = f32::from(bs[Stat::SpA]) / 255.0;
+            o[58] = f32::from(bs[Stat::SpD]) / 255.0;
+            o[59] = f32::from(bs[Stat::Spe]) / 255.0;
+        }
+    }
+
+    // Sides
+    let side_base = 2 * ROWS * RICH_MON_WIDTH;
+    for (ego, side_id) in sides.into_iter().enumerate() {
+        let s = state.side(side_id);
+        let o = &mut out[side_base + ego * RICH_SIDE_WIDTH..][..RICH_SIDE_WIDTH];
+        let size = s.team.len().min(ROWS) as u8;
+        let fainted = s.team.iter().filter(|p| p.is_fainted()).count() as u8;
+        o[0] = f32::from(size) / 6.0;
+        o[1] = if size > 0 { f32::from(fainted.min(size)) / f32::from(size) } else { 0.0 };
+        o[2] = flag(
+            s.gimmicks_used.contains(pikapro::Gimmick::MegaEvolve)
+                || s.gimmicks_used.contains(pikapro::Gimmick::Terastallize),
+        );
+        let c = &s.conditions;
+        o[3] = flag(c.tailwind > 0);
+        o[4] = f32::from(c.tailwind.min(4)) / 4.0;
+        o[5] = flag(c.reflect > 0);
+        o[6] = f32::from(c.reflect.min(5)) / 5.0;
+        o[7] = flag(c.light_screen > 0);
+        o[8] = f32::from(c.light_screen.min(5)) / 5.0;
+        o[9] = flag(c.aurora_veil > 0);
+        o[10] = f32::from(c.aurora_veil.min(5)) / 5.0;
+        o[11] = flag(c.safeguard > 0);
+        o[12] = flag(c.mist > 0);
+        o[13] = flag(c.wide_guard > 0);
+        o[14] = flag(c.quick_guard > 0);
+        o[15] = flag(c.stealth_rock > 0);
+        o[16] = f32::from(c.spikes.min(3)) / 3.0;
+        o[17] = f32::from(c.toxic_spikes.min(2)) / 2.0;
+        o[18] = flag(c.sticky_web > 0);
+        o[19] = flag(c.fire_pledge > 0 || c.grass_pledge > 0 || c.water_pledge > 0);
+    }
+
+    // Field
+    let f = &state.field;
+    let o = &mut out[side_base + 2 * RICH_SIDE_WIDTH..][..RICH_FIELD_WIDTH];
+    if let Some(w) = f.weather {
+        one_hot(&mut o[0..WEATHER_LEN], weather_index(w));
+        o[7] = f32::from(f.weather_turns.min(5)) / 5.0;
+    }
+    if let Some(t) = f.terrain {
+        one_hot(&mut o[8..8 + TERRAIN_LEN], terrain_index(t));
+        o[12] = f32::from(f.terrain_turns.min(5)) / 5.0;
+    }
+    o[13] = flag(f.trick_room_turns > 0);
+    o[14] = f32::from(f.trick_room_turns.min(5)) / 5.0;
+    o[15] = flag(f.gravity_turns > 0);
+    o[16] = f32::from(f.gravity_turns.min(5)) / 5.0;
+    o[17] = flag(f.magic_room_turns > 0);
+    o[18] = flag(f.wonder_room_turns > 0);
+    o[19] = flag(f.fairy_lock_turns > 0);
+    o[20] = f32::from(state.turn.min(100)) / 100.0;
+    let (req_idx, fs0, fs1) = match battle.request(me) {
+        Request::Wait => (0, false, false),
+        Request::TeamPreview { .. } => (1, false, false),
+        Request::Move => (2, false, false),
+        Request::ForceSwitch { slots } => (3, slots[0], slots[1]),
+    };
+    one_hot(&mut o[21..25], req_idx);
+    o[25] = flag(fs0);
+    o[26] = flag(fs1);
+    let active_count = state.side(me).active.iter().filter(|s| s.is_some()).count();
+    o[27] = active_count as f32 / 2.0;
+}
