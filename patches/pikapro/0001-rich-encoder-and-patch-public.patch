+    /// Fog-safe `rich` observation (`float32` array of length `1028`) from the battle's
+    /// public log and `side`'s request.
+    fn encode_rich<'py>(&self, py: Python<'py>, side: &Bound<'py, PyAny>) -> PyResult<Bound<'py, PyAny>> {
+        use pikapro_rl::encode::{Encoder, Rich};
+        let side = side_arg(side)?;
+        let tables = pikapro_rl::tables::Tables::for_format(self.game.battle.format());
+        let mut out = vec![0.0f32; Rich::SIZE];
+        self.game
+            .with_view(side, |view| Rich.encode(&view, &tables, &mut out))
+            .map_err(err)?;
+        array(py, out, vec![Rich::SIZE])
+    }
