+//! Direct public-state patching for fast search roots (`Battle::patch_public`).
+//!
+//! Lets a search mirror start a `Battle` with our known team and a hypothesized
+//! opponent team, then jump straight to the current public turn state without
+//! replaying prior turns through Node.js Showdown.
+
+use pikapro_data::{AbilityId, ItemId, MoveId, SpeciesId, Stat};
+
+use crate::battle::Battle;
+use crate::format::Gimmick;
+use crate::request::Request;
+use crate::resolve;
+use crate::state::{
+    Boosts, MAX_ACTIVE, PseudoWeather, SideCondition, SideConditions, SideId, Status, SwitchFlag, Terrain, Volatiles,
+    Weather,
+};
+use crate::util::StackVec;
+
+/// Patch for one Pokémon on a side.
+#[derive(Clone, Debug, Default)]
+pub struct MonPatch {
+    /// Species name or ID to match in the side's team (base or current forme).
+    pub match_species: Option<SpeciesId>,
+    /// Optional target Mega/battle forme to transform into permanently.
+    pub forme_species: Option<SpeciesId>,
+    /// Exact HP if known (own side).
+    pub hp_exact: Option<u16>,
+    /// Public HP percent (`0..=100`, foe side when exact HP is unknown).
+    pub hp_pct: Option<u16>,
+    /// Explicit fainted flag.
+    pub fainted: bool,
+    /// Non-volatile status.
+    pub status: Status,
+    /// Stat stages (applied to active Pokémon).
+    pub boosts: Boosts,
+    /// `Some(Some(id))` sets item, `Some(None)` clears item, `None` leaves as built.
+    pub item: Option<Option<ItemId>>,
+    /// Optional ability override.
+    pub ability: Option<AbilityId>,
+    /// Consecutive Protect count (`0` = none).
+    pub protect_counter: u8,
+    /// Turns spent active since switching in.
+    pub active_turns: u16,
+    /// Move actions taken since switching in (Fake Out checks `== 0`).
+    pub active_move_actions: u8,
+    /// Trapped flag.
+    pub trapped: bool,
+    /// Choice lock move, if known.
+    pub choice_lock: Option<MoveId>,
+    /// Encore move and remaining turns (`0` = none).
+    pub encore: Option<(MoveId, u8)>,
+    /// Disable move and remaining turns (`0` = none).
+    pub disable: Option<(MoveId, u8)>,
+    /// Taunt remaining turns (`0` = none).
+    pub taunt_turns: u8,
+    /// Confusion remaining checks (`0` = none).
+    pub confusion_turns: u8,
+    /// Substitute active.
+    pub substitute: bool,
+    /// Must recharge active.
+    pub must_recharge: bool,
+    /// Unburden active (lost item this stint).
+    pub unburden: bool,
+    /// Last move used by this Pokémon (for Encore/Disable/Torment).
+    pub last_move: Option<MoveId>,
+    /// Perish Song remaining turns (`3..=1`, `0` = none).
+    pub perish_turns: u8,
+    /// Yawn remaining turns (`1` = falls asleep end of this turn, `0` = none).
+    pub yawn_turns: u8,
+    /// Leech Seed active, storing the foe slot (`0` or `1`) that receives healing.
+    pub leech_seed: Option<u8>,
+    /// Salt Cure active.
+    pub salt_cure: bool,
+    /// Ghost-type Curse active.
+    pub curse: bool,
+    /// Syrup Bomb remaining turns (`0` = none).
+    pub syrup_bomb_turns: u8,
+    /// Heal Block (Psychic Noise) remaining turns (`0` = none).
+    pub heal_block_turns: u8,
+    /// Throat Chop remaining turns (`0` = none).
+    pub throat_chop_turns: u8,
+    /// Partially trapped (Bind/Whirlpool/Fire Spin/Magma Storm/Sand Tomb): `(move_id, turns)`.
+    pub partially_trapped: Option<(MoveId, u8)>,
+    /// Rampage lock (Outrage/Thrash/Petal Dance/Raging Fury): `(move_id, remaining_turns)`.
+    pub locked_move: Option<(MoveId, u8)>,
+    /// Two-turn charging move (Electro Shot/Solar Beam/Fly/Phantom Force): `(move_id, target_loc)`.
+    pub two_turn_move: Option<(MoveId, i8)>,
+    /// Per-move PP overrides `(move_id, pp)`.
+    pub move_pp: Vec<(MoveId, u8)>,
+    /// Explicitly disabled moves.
+    pub disabled_moves: Vec<MoveId>,
+}
+
+/// Patch for one side.
+#[derive(Clone, Debug, Default)]
+pub struct SidePatch {
+    /// Per-Pokémon patches.
+    pub mons: Vec<MonPatch>,
+    /// Species IDs currently in active slots `0..MAX_ACTIVE` (`None` if empty/fainted).
+    pub active_species: [Option<SpeciesId>; MAX_ACTIVE],
+    /// Whether each active slot requires a forced switch right now.
+    pub force_switch: [bool; MAX_ACTIVE],
+    /// Whether this side has already used Mega Evolution.
+    pub mega_used: bool,
+    /// Total fainted Pokémon count.
+    pub total_fainted: u8,
+    /// Whether a teammate fainted last turn.
+    pub fainted_last_turn: bool,
+    /// Side conditions and their turns/layers.
+    pub side_conditions: Vec<(SideCondition, u8)>,
+}
+
+/// Complete public-state patch for a `Battle`.
+#[derive(Clone, Debug, Default)]
+pub struct PublicPatch {
+    /// Current turn number (`>= 1`).
+    pub turn: u16,
+    /// Active weather and turns remaining.
+    pub weather: Option<(Weather, u8)>,
+    /// Active terrain and turns remaining.
+    pub terrain: Option<(Terrain, u8)>,
+    /// Trick Room turns remaining (`0` = inactive).
+    pub trick_room_turns: u8,
+    /// Gravity turns remaining (`0` = inactive).
+    pub gravity_turns: u8,
+    /// Magic Room turns remaining (`0` = inactive).
+    pub magic_room_turns: u8,
+    /// Wonder Room turns remaining (`0` = inactive).
+    pub wonder_room_turns: u8,
+    /// Fairy Lock turns remaining (`0` = inactive).
+    pub fairy_lock_turns: u8,
+    /// Patches for `[P1, P2]`.
+    pub sides: [SidePatch; 2],
+}
+
+fn find_mon_index(
+    side: &crate::state::SideState,
+    dex: &pikapro_data::Dex,
+    target: SpeciesId,
+    used: &[bool],
+) -> Option<usize> {
+    let target_base = dex.species(target).base_species;
+    // Exact species match first.
+    if let Some(i) = side
+        .team
+        .iter()
+        .enumerate()
+        .position(|(i, m)| !used[i] && (m.species == target || m.base_species == target || m.set_species == target))
+    {
+        return Some(i);
+    }
+    // Base-species fallback (handles Mega / forme changes).
+    side.team.iter().enumerate().position(|(i, m)| {
+        !used[i]
+            && (dex.species(m.species).base_species == target_base
+                || dex.species(m.base_species).base_species == target_base)
+    })
+}
+
+impl Battle {
+    /// Patches the battle state in place to match a live public observation snapshot,
+    /// refreshing event filters, active slots, requests, and legal actions.
+    pub fn patch_public(&mut self, patch: &PublicPatch) {
+        let dex = self.format.dex;
+        self.state.turn = patch.turn.max(1);
+        self.result = None;
+        self.mid_turn = false;
+        self.active_move = None;
+        self.faint_queue = StackVec::new();
+        self.queue = resolve::Queue::default();
+        self.pending = [None, None];
+
+        // Patch field
+        let field = &mut self.state.field;
+        *field = crate::state::FieldState::default();
+        if let Some((w, turns)) = patch.weather {
+            field.weather = Some(w);
+            field.weather_turns = turns;
+        }
+        if let Some((t, turns)) = patch.terrain {
+            field.terrain = Some(t);
+            field.terrain_turns = turns;
+        }
+        if patch.trick_room_turns > 0 {
+            field.trick_room_turns = patch.trick_room_turns;
+            field.pseudo_order.push(PseudoWeather::TrickRoom);
+        }
+        if patch.gravity_turns > 0 {
+            field.gravity_turns = patch.gravity_turns;
+            field.pseudo_order.push(PseudoWeather::Gravity);
+        }
+        if patch.magic_room_turns > 0 {
+            field.magic_room_turns = patch.magic_room_turns;
+            field.pseudo_order.push(PseudoWeather::MagicRoom);
+        }
+        if patch.wonder_room_turns > 0 {
+            field.wonder_room_turns = patch.wonder_room_turns;
+            field.pseudo_order.push(PseudoWeather::WonderRoom);
+        }
+        if patch.fairy_lock_turns > 0 {
+            field.fairy_lock_turns = patch.fairy_lock_turns;
+            field.pseudo_order.push(PseudoWeather::FairyLock);
+        }
+
+        // Patch both sides
+        for side_id in SideId::BOTH {
+            let sp = &patch.sides[side_id.index()];
+            let side = self.state.side_mut(side_id);
+            let team_len = side.team.len();
+            let mut used = vec![false; team_len];
+
+            for mp in &sp.mons {
+                let Some(target) = mp.match_species else { continue };
+                let Some(idx) = find_mon_index(side, dex, target, &used) else { continue };
+                used[idx] = true;
+                let mon = &mut side.team[idx];
+
+                // Permanent Mega / forme change first so stats & types update before HP.
+                if let Some(forme) = mp.forme_species
+                    && forme != mon.species
+                {
+                    mon.change_species(dex, forme);
+                    mon.base_species = forme;
+                    let data = dex.species(forme);
+                    mon.base_types = data.types;
+                    mon.species_types = data.types;
+                    for stat in [Stat::Atk, Stat::Def, Stat::SpA, Stat::SpD, Stat::Spe] {
+                        mon.set_stats[stat] = mon.stats[stat];
+                    }
+                    mon.ability = data.abilities.primary;
+                    mon.base_ability = data.abilities.primary;
+                }
+
+                if let Some(item_opt) = mp.item {
+                    mon.item = item_opt;
+                }
+                if let Some(ab) = mp.ability {
+                    mon.ability = ab;
+                }
+
+                // Reset volatiles/boosts cleanly before applying observed state.
+                mon.volatiles = Volatiles::default();
+                mon.volatile_counters = crate::state::VolatileCounters::default();
+                mon.boosts = Boosts::default();
+                mon.protect_counter = 0;
+                mon.stall_turns = 0;
+                mon.trapped = false;
+                mon.switch_flag = SwitchFlag::None;
+                mon.force_switch_flag = false;
+                mon.effect_disabled = 0;
+
+                let max_hp = mon.stats[Stat::Hp];
+                if mp.fainted {
+                    mon.hp = 0;
+                    mon.status = Status::None;
+                } else {
+                    if let Some(exact) = mp.hp_exact {
+                        mon.hp = exact.min(max_hp);
+                    } else if let Some(pct) = mp.hp_pct {
+                        if pct == 0 {
+                            mon.hp = 0;
+                        } else if pct >= 100 {
+                            mon.hp = max_hp;
+                        } else {
+                            // Unbiased midpoint of Champions `floor(100 * hp / max_hp) || 1`.
+                            let m = u32::from(max_hp);
+                            let p = u32::from(pct);
+                            let low = ((p * m + 99) / 100).max(1);
+                            let high_excl = (((p + 1) * m + 99) / 100).saturating_sub(1);
+                            let high = high_excl.min(m.saturating_sub(1)).max(low);
+                            mon.hp = (((low + high) / 2) as u16).clamp(1, max_hp);
+                        }
+                    }
+                    mon.status = mp.status;
+                    mon.boosts = mp.boosts;
+                    mon.protect_counter = mp.protect_counter;
+                    if mp.protect_counter > 0 {
+                        mon.volatiles.set(Volatiles::STALL);
+                        // By the next turn's decision, Showdown/pikapro has already ticked
+                        // `stall_turns` from 2 down to 1 during the previous turn's residual.
+                        mon.stall_turns = 1;
+                    }
+                    mon.active_turns = mp.active_turns;
+                    mon.active_move_actions = mp.active_move_actions;
+                    mon.volatile_counters.settled = mp.active_turns > 0;
+                    mon.trapped = mp.trapped;
+                    if let Some(mv) = mp.last_move {
+                        mon.last_move = Some(mv);
+                    }
+
+                    if let Some(mv) = mp.choice_lock {
+                        mon.volatiles.set(Volatiles::CHOICE_LOCK);
+                        mon.volatile_counters.choice_lock = mv;
+                        mon.last_move = Some(mv);
+                    }
+                    if let Some((mv, turns)) = mp.encore
+                        && turns > 0
+                    {
+                        mon.volatiles.set(Volatiles::ENCORE);
+                        mon.volatile_counters.encore = turns;
+                        mon.volatile_counters.encore_move = mv;
+                    }
+                    if let Some((mv, turns)) = mp.disable
+                        && turns > 0
+                    {
+                        mon.volatiles.set(Volatiles::DISABLE);
+                        mon.volatile_counters.disable = turns;
+                        mon.volatile_counters.disable_move = mv;
+                    }
+                    if mp.taunt_turns > 0 {
+                        mon.volatiles.set(Volatiles::TAUNT);
+                        mon.volatile_counters.taunt = mp.taunt_turns;
+                    }
+                    if mp.confusion_turns > 0 {
+                        mon.volatiles.set(Volatiles::CONFUSION);
+                        mon.volatile_counters.confusion = mp.confusion_turns;
+                    }
+                    if mp.substitute {
+                        mon.volatiles.set(Volatiles::SUBSTITUTE);
+                        mon.volatile_counters.substitute_hp_halves = ((max_hp / 4).max(1)) * 2;
+                    }
+                    if mp.must_recharge {
+                        mon.volatiles.set(Volatiles::MUST_RECHARGE);
+                        mon.volatile_counters.must_recharge = 1;
+                    }
+                    if mp.unburden {
+                        mon.volatiles.set(Volatiles::UNBURDEN);
+                    }
+                    if mp.perish_turns > 0 {
+                        mon.volatiles.set(Volatiles::PERISH_SONG);
+                        mon.volatile_counters.perish_song = mp.perish_turns;
+                    }
+                    if mp.yawn_turns > 0 {
+                        mon.volatiles.set(Volatiles::YAWN);
+                        mon.volatile_counters.yawn = mp.yawn_turns;
+                        mon.volatile_counters.yawn_source = crate::state::Position::new(side_id.foe(), 0);
+                    }
+                    if let Some(foe_slot) = mp.leech_seed {
+                        mon.volatiles.set(Volatiles::LEECH_SEED);
+                        mon.volatile_counters.leech_seed_slot =
+                            crate::state::Position::new(side_id.foe(), foe_slot.min(1));
+                    }
+                    if mp.salt_cure {
+                        mon.volatiles.set(Volatiles::SALT_CURE);
+                    }
+                    if mp.curse {
+                        mon.volatiles.set(Volatiles::CURSE);
+                    }
+                    if mp.syrup_bomb_turns > 0 {
+                        mon.volatiles.set(Volatiles::SYRUP_BOMB);
+                        mon.volatile_counters.syrup_bomb = mp.syrup_bomb_turns;
+                        mon.volatile_counters.syrup_bomb_by = (side_id.foe(), 0);
+                    }
+                    if mp.heal_block_turns > 0 {
+                        mon.volatiles.set(Volatiles::HEAL_BLOCK);
+                        mon.volatile_counters.heal_block = mp.heal_block_turns;
+                    }
+                    if mp.throat_chop_turns > 0 {
+                        mon.volatiles.set(Volatiles::THROAT_CHOP);
+                        mon.volatile_counters.throat_chop = mp.throat_chop_turns;
+                    }
+                    if let Some((mv, turns)) = mp.partially_trapped
+                        && turns > 0
+                    {
+                        mon.volatiles.set(Volatiles::PARTIALLY_TRAPPED);
+                        mon.volatile_counters.partially_trapped = turns;
+                        mon.volatile_counters.partially_trapped_move = mv;
+                        mon.volatile_counters.partially_trapped_by = (side_id.foe(), 0);
+                    }
+                    if let Some((mv, turns)) = mp.locked_move
+                        && turns > 0
+                    {
+                        mon.volatiles.set(Volatiles::LOCKED_MOVE);
+                        mon.volatile_counters.locked_move = turns;
+                        mon.volatile_counters.locked_true_duration = turns;
+                        mon.volatile_counters.locked_move_id = mv;
+                    }
+                    if let Some((mv, target_loc)) = mp.two_turn_move {
+                        mon.volatiles.set(Volatiles::TWO_TURN_MOVE);
+                        mon.volatiles.set(Volatiles::CHARGING);
+                        mon.volatile_counters.two_turn = 1;
+                        mon.volatile_counters.charge_move = mv;
+                        mon.volatile_counters.charging = 1;
+                        mon.volatile_counters.charge_target_loc = target_loc;
+                    }
+                }
+
+                // Per-move PP and disabled flags
+                for slot in mon.moves.iter_mut() {
+                    slot.disabled = false;
+                    if let Some(&(_, pp)) = mp.move_pp.iter().find(|&&(id, _)| id == slot.id) {
+                        slot.pp = pp.min(slot.max_pp);
+                    }
+                    if mp.disabled_moves.contains(&slot.id) {
+                        slot.disabled = true;
+                    }
+                }
+            }
+
+            // Reorder team so active slots sit at 0..MAX_ACTIVE as pikapro requires.
+            let mut desired_active: [Option<usize>; MAX_ACTIVE] = [None; MAX_ACTIVE];
+            let mut placed = vec![false; team_len];
+            for slot in 0..MAX_ACTIVE {
+                if let Some(target) = sp.active_species[slot]
+                    && let Some(idx) = find_mon_index(side, dex, target, &placed)
+                {
+                    desired_active[slot] = Some(idx);
+                    placed[idx] = true;
+                }
+            }
+            // Build reordered team: slot 0, slot 1, then remaining bench.
+            let mut new_order: Vec<usize> = Vec::with_capacity(team_len);
+            let mut active_slots: [Option<u8>; MAX_ACTIVE] = [None; MAX_ACTIVE];
+            for slot in 0..MAX_ACTIVE {
+                if let Some(idx) = desired_active[slot] {
+                    let pos = new_order.len();
+                    new_order.push(idx);
+                    if !side.team[idx].is_fainted() && !sp.force_switch[slot] {
+                        active_slots[slot] = Some(pos as u8);
+                    }
+                } else {
+                    // Find a fainted/unused placeholder if needed to keep slot indexing aligned.
+                    if let Some(idx) = (0..team_len).find(|&i| !placed[i] && side.team[i].is_fainted()) {
+                        placed[idx] = true;
+                        new_order.push(idx);
+                    } else if let Some(idx) = (0..team_len).find(|&i| !placed[i]) {
+                        placed[idx] = true;
+                        let pos = new_order.len();
+                        new_order.push(idx);
+                        if !side.team[idx].is_fainted() && !sp.force_switch[slot] {
+                            active_slots[slot] = Some(pos as u8);
+                        }
+                    }
+                }
+            }
+            for i in 0..team_len {
+                if !placed[i] {
+                    new_order.push(i);
+                }
+            }
+            let old_team = side.team;
+            side.team = StackVec::new();
+            for idx in new_order {
+                side.team.push(old_team[idx]);
+            }
+            side.active = active_slots;
+
+            // Reset counters for benched Pokémon; set switch_flag for force_switch slots.
+            for (idx, mon) in side.team.iter_mut().enumerate() {
+                let is_active = side.active.contains(&Some(idx as u8));
+                if !is_active {
+                    mon.active_turns = 0;
+                    mon.active_move_actions = 0;
+                    mon.boosts = Boosts::default();
+                }
+                if idx < MAX_ACTIVE && sp.force_switch[idx] {
+                    mon.switch_flag = SwitchFlag::Fainted;
+                }
+            }
+
+            // Gimmicks and can_mega_evo
+            side.gimmicks_used = crate::format::Gimmicks::default();
+            if sp.mega_used {
+                side.gimmicks_used.insert(Gimmick::MegaEvolve);
+            }
+            for mon in side.team.iter_mut() {
+                mon.can_mega_evo = if sp.mega_used {
+                    None
+                } else {
+                    resolve::mega::can_mega_evo(&self.format, mon.base_species, mon.item)
+                };
+            }
+
+            let now_fainted = side.team.iter().filter(|m| m.is_fainted()).count() as u8;
+            side.total_fainted = sp.total_fainted.max(now_fainted);
+            side.fainted_last_turn = sp.fainted_last_turn;
+
+            // Side conditions
+            let mut conds = SideConditions::default();
+            for &(cond, val) in &sp.side_conditions {
+                if val > 0 {
+                    *conds.turns_mut(cond) = val;
+                    if !conds.order.contains(&cond) {
+                        conds.order.push(cond);
+                    }
+                }
+            }
+            side.conditions = conds;
+        }
+
+        // Refresh requests based on force_switch flags.
+        let fs_p1 = patch.sides[0].force_switch;
+        let fs_p2 = patch.sides[1].force_switch;
+        let any_fs1 = fs_p1.iter().any(|&x| x);
+        let any_fs2 = fs_p2.iter().any(|&x| x);
+        if any_fs1 || any_fs2 {
+            self.requests[0] = if any_fs1 {
+                Request::ForceSwitch { slots: fs_p1 }
+            } else {
+                Request::Wait
+            };
+            self.requests[1] = if any_fs2 {
+                Request::ForceSwitch { slots: fs_p2 }
+            } else {
+                Request::Wait
+            };
+        } else {
+            self.requests = [Request::Move, Request::Move];
+        }
+
+        // Refresh event filters, condition caches, DisableMove flags, and legal actions.
+        (self.event_filter, self.prefixed_filter) = resolve::events::filters(self);
+        self.conditions_version = self.conditions_version.wrapping_add(1);
+        self.masks_memo = resolve::events::MasksMemo::EMPTY;
+        self.masks_cached = resolve::events::Cached::No;
+        self.fresh_speeds = 0;
+
+        // Run pikapro's own `DisableMove` pass (enforces Choice lock, Encore, Disable,
+        // Taunt, Heal Block, Throat Chop, Torment, Imprison, Gravity, Fake Out, etc.)
+        // while preserving any explicitly patched disabled move flags from our request.
+        for side_id in SideId::BOTH {
+            for slot in 0..MAX_ACTIVE {
+                let pos = crate::state::Position::new(side_id, slot as u8);
+                let Some(mon) = self.state.at(pos) else { continue };
+                if mon.is_fainted() {
+                    continue;
+                }
+                let explicit: [bool; crate::state::MAX_MOVES] = {
+                    let mut arr = [false; crate::state::MAX_MOVES];
+                    for (i, m) in mon.moves.iter().enumerate() {
+                        arr[i] = m.disabled;
+                    }
+                    arr
+                };
+                resolve::volatiles::disable_moves(self, pos);
+                if let Some(mon_mut) = self.state.at_mut(pos) {
+                    for (i, m) in mon_mut.moves.iter_mut().enumerate() {
+                        if explicit[i] {
+                            m.disabled = true;
+                            mon_mut.effect_disabled |= 1 << i;
+                        }
+                    }
+                }
+            }
+        }
+
+        self.refresh_legal();
+    }
+}
