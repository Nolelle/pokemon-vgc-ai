+        let tables = pikapro_rl::tables::Tables::for_format(self.game.battle.format());
+        let items: Vec<Option<pikapro_data::ItemId>> = foe_known_items
+            .unwrap_or_default()
+            .into_iter()
+            .map(|opt| opt.and_then(|s| dex.item_by_name(&s)))
+            .collect();
+        let abilities: Vec<Option<pikapro_data::AbilityId>> = foe_known_abilities
+            .unwrap_or_default()
+            .into_iter()
+            .map(|opt| opt.and_then(|s| dex.ability_by_name(&s)))
+            .collect();
+        let moves: Vec<Vec<pikapro_data::MoveId>> = foe_known_moves
+            .unwrap_or_default()
+            .into_iter()
+            .map(|list| list.into_iter().filter_map(|s| dex.move_by_name(&s)).collect())
+            .collect();
+        let mut out = vec![0.0f32; Rich::SIZE];
+        encode_battle_state_rich(
+            &self.game.battle,
+            side,
+            &tables,
+            Some(&self.game.team[side.index()]),
+            Some(&self.game.team[side.foe().index()]),
+            &items,
+            &abilities,
+            &moves,
+            &mut out,
+        );
+        array(py, out, vec![Rich::SIZE])
+    }
